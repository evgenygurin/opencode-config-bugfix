{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/cohere/north-mini-code:free",
  "small_model": "openrouter/cohere/north-mini-code:free",
  "provider": {
    "openrouter": {
      "whitelist": ["cohere/north-mini-code:free"],
      "options": { "apiKey": "{env:OPENROUTER_API_KEY}" }
    }
  },
  "plugin": ["@mem0/opencode-plugin", "railway", "oh-my-openagent"],
  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "enabled": true },
    "github": { "type": "remote", "url": "https://api.githubcopilot.com/mcp/", "enabled": true },
    "railway": { "type": "remote", "url": "https://mcp.railway.com", "enabled": true }
  },
  "permission": { "edit": "ask", "bash": { "*": "ask" }, "github_*": "ask", "railway_*": "ask" },
  "snapshot": true,
  "share": "disabled"
}